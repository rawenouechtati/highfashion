  <property name="styleSheet">
   <string>/* ===== GEvents – thème &quot;Atelier Vintage Couture&quot; (design photo 1) ===== */
* { font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Arial; font-size: 13px; color: #1c2b3a; }
QMainWindow, QFrame#contentFrame { background: #f5f3ef; }
/* ---------- Sidebar ---------- */
QFrame#sidebar { background: #17375e; }
QFrame#sidebar QLabel { color: #ffffff; }
QLabel#lblUserName { font-weight: 600; font-size: 13px; }
QLabel#lblUserRole { color: #b7c6d9; font-size: 12px; }
QFrame#sidebar QPushButton {
    color: #e8eef6; background: transparent; border: none; text-align: left;
    padding: 12px 16px; border-radius: 8px; font-size: 14px;
}
QFrame#sidebar QPushButton:hover { background: rgba(255, 255, 255, 0.10); }
QFrame#sidebar QPushButton:checked { background: #2c527f; color: #ffffff; font-weight: 600; }
/* ---------- En-tête ---------- */
QLabel#lblHeaderIcon { font-size: 34px; color: #17375e; }
QLabel#lblTitle { font-size: 24px; font-weight: 700; color: #17375e; }
QLabel#lblSubtitle { color: #6b7785; }
/* ---------- Champs ---------- */
QLineEdit, QComboBox, QDateEdit, QTimeEdit, QPlainTextEdit {
    background: #ffffff; border: 1px solid #d9d5ce; border-radius: 8px;
    padding: 6px 10px; min-height: 22px;
    selection-background-color: #2c527f; selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QPlainTextEdit:focus { border: 1px solid #17375e; }
QComboBox QAbstractItemView {
    background: #ffffff; border: 1px solid #d9d5ce;
    selection-background-color: #dce9f7; selection-color: #17375e; outline: 0;
}
QLineEdit#lineSearch { min-height: 26px; }
/* ---------- Boutons ---------- */
QPushButton { background: #ffffff; border: 1px solid #17375e; color: #17375e; border-radius: 8px; padding: 8px 16px; font-weight: 600; }
QPushButton:hover { background: #eef3f9; }
QPushButton:pressed { background: #dce9f7; }
QPushButton#btnAjouter, QPushButton#btnEnregistrer { background: #9b2335; border: 1px solid #9b2335; color: #ffffff; }
QPushButton#btnAjouter:hover, QPushButton#btnEnregistrer:hover { background: #831c2c; }
QPushButton#btnSupprimer { border: 1px solid #c0392b; color: #c0392b; }
QPushButton#btnSupprimer:hover { background: #fdecea; }
QPushButton#btnReinitialiser { border: 1px solid #d9d5ce; color: #4a5a6b; font-weight: 500; }
QPushButton#btnChoisirImage { text-align: left; font-weight: 500; color: #4a5a6b; border: 1px solid #d9d5ce; }
/* ---------- Cartes / panneaux ---------- */
QFrame[cssClass=&quot;card&quot;] { background: #ffffff; border: 1px solid #e3e0da; border-radius: 12px; }
QFrame#cardTotal   { border-left: 4px solid #17375e; }
QFrame#cardAVenir  { border-left: 4px solid #2f80d1; }
QFrame#cardProgramme { border-left: 4px solid #2e9e5b; }
QFrame#cardPlanifie  { border-left: 4px solid #e0a81e; }
QLabel[cssClass=&quot;cardIcon&quot;] { font-size: 26px; }
QLabel[cssClass=&quot;cardTitle&quot;] { color: #6b7785; font-size: 12px; }
QLabel[cssClass=&quot;cardValue&quot;] { font-size: 26px; font-weight: 700; color: #17375e; }
QLabel[cssClass=&quot;panelTitle&quot;] { font-weight: 700; font-size: 14px; color: #17375e; }
QLabel[cssClass=&quot;field&quot;] { font-size: 12px; font-weight: 600; color: #4a5a6b; }
QLabel[cssClass=&quot;imagePreview&quot;] { background: #f5f3ef; border: 1px dashed #c9c4bb; border-radius: 8px; font-size: 22px; }
/* ---------- Tableau ---------- */
QTableWidget {
    background: #ffffff; border: 1px solid #e3e0da; border-radius: 12px;
    gridline-color: transparent; outline: 0;
    selection-background-color: #dce9f7; selection-color: #1c2b3a;
}
QTableWidget::item { padding: 4px 8px; border-bottom: 1px solid #f0ede8; }
QTableWidget::item:selected { background: #dce9f7; color: #1c2b3a; }
QHeaderView::section { background: #17375e; color: #ffffff; padding: 10px 8px; border: none; font-weight: 600; text-align: left; }
/* ---------- Badges de statut ---------- */
QLabel[badge] { border-radius: 10px; padding: 3px 12px; font-weight: 600; font-size: 12px; }
QLabel[badge=&quot;programme&quot;] { background: #d4f0dc; color: #1e7e3e; }
QLabel[badge=&quot;avenir&quot;]    { background: #d6e8fb; color: #1f5fa8; }
QLabel[badge=&quot;planifie&quot;]  { background: #fdf0c4; color: #a07a00; }
QLabel[badge=&quot;encours&quot;]   { background: #fbd9c3; color: #b4531a; }
QLabel[badge=&quot;termine&quot;]   { background: #e1e4e8; color: #4b5563; }
/* ---------- Liste des lieux ---------- */
QListWidget { background: transparent; border: none; outline: 0; }
QListWidget::item { padding: 7px 4px; border-bottom: 1px solid #f0ede8; }
QListWidget::item:selected { background: #dce9f7; color: #17375e; }
/* ---------- Calendrier ---------- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #17375e; border-radius: 6px; }
QCalendarWidget QToolButton { color: #ffffff; background: transparent; border: none; font-weight: 600; padding: 4px 8px; }
QCalendarWidget QToolButton:hover { background: rgba(255, 255, 255, 0.15); border-radius: 4px; }
QCalendarWidget QSpinBox { color: #ffffff; background: transparent; border: none; }
QCalendarWidget QAbstractItemView:enabled {
    background: #ffffff; color: #1c2b3a; outline: 0;
    selection-background-color: #17375e; selection-color: #ffffff;
}
QCalendarWidget QAbstractItemView:disabled { color: #b5bcc5; }
/* ---------- Scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #c9c4bb; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: #c9c4bb; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
/* ---------- Graphiques (barres) ---------- */
QProgressBar { background: #eef1f5; border: none; border-radius: 4px; min-width: 22px; max-width: 30px; }
QProgressBar::chunk { background: #17375e; border-radius: 4px; }
QProgressBar[cssClass=&quot;evolBar&quot;] { min-width: 14px; max-width: 20px; }
QProgressBar[cssClass=&quot;evolBar&quot;]::chunk { background: #9b2335; }
QLabel[cssClass=&quot;barValue&quot;] { font-weight: 700; color: #17375e; font-size: 12px; }
QLabel[cssClass=&quot;barName&quot;] { color: #6b7785; font-size: 10px; }
</string>
