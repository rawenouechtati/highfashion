  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #F5F1E8;
}

QWidget {
    color: #1F3A4D;
    font-family: &quot;Segoe UI&quot;;
}

QPushButton {
    background-color: #1F3A4D;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #8B1E2D;
}

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: white;
    color: #1F3A4D;
    border: 1px solid #B39B6A;
    border-radius: 5px;
    padding: 6px;
}

QTableWidget {
    background-color: white;
    color: #1F3A4D;
    border: 1px solid #B39B6A;
    gridline-color: #B39B6A;
}

QHeaderView::section {
    background-color: #1F3A4D;
    color: white;
    padding: 7px;
    border: none;
}

QGroupBox {
    color: #1F3A4D;
    font-weight: bold;
    border: 1px solid #B39B6A;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
}

QLabel {
    color: #1F3A4D;
}

QCheckBox {
    color: #1F3A4D;
}

QListWidget {
    background-color: #F5F1E8;
    color: #1F3A4D;
    border: 1px solid #B39B6A;
    border-radius: 6px;
}</string>
