QMainWindow, #centralwidget {
    background-color: #F5F1E8;
}

QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CDBF9F;
    border-radius: 7px;
    padding: 6px 10px;
    font-family: "Lato";
    font-size: 10pt;
    color: #1F3A4D;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #B39B6A;
}

QPushButton {
    border-radius: 7px;
    padding: 7px 16px;
    font-family: "Lato";
    font-weight: bold;
    font-size: 10pt;
}

QPushButton#btnAjouter, QPushButton#btnEnregistrer {
    background-color: #8B1E2D;
    color: white;
    border: none;
}
QPushButton#btnAjouter:hover, QPushButton#btnEnregistrer:hover {
    background-color: #711824;
}

QPushButton#btnModifier, QPushButton#btnAnnuler {
    background-color: white;
    color: #1F3A4D;
    border: 1px solid #1F3A4D;
}
QPushButton#btnModifier:hover, QPushButton#btnAnnuler:hover {
    background-color: #EEF1F4;
}

QPushButton#btnSupprimer {
    background-color: white;
    color: #8B1E2D;
    border: 1px solid #8B1E2D;
}
QPushButton#btnSupprimer:hover {
    background-color: #FBEEEF;
}

QTableWidget {
    background-color: white;
    gridline-color: #ECE4D0;
    border: 1px solid #DCCFB0;
    border-radius: 6px;
    font-family: "Lato";
}
QHeaderView::section {
    background-color: #1F3A4D;
    color: white;
    padding: 6px;
    border: none;
    font-weight: bold;
}
QTableWidget::item:selected {
    background-color: #F4DFE2;
    color: #1F3A4D;
}

QGroupBox {
    border: 1px solid #B39B6A;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 6px;
    font-family: "Lato";
}
QGroupBox::title {
    font-family: "Playfair Display";
    font-size: 15pt;
    font-weight: bold;
    color: #1F3A4D;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 6px;
}

QLabel {
    font-family: "Lato";
    font-weight: bold;
    color: #5F707D;
    font-size: 9pt;
}