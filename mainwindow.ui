      <widget class="QWidget" name="PEvenement">
       <property name="styleSheet">
        <string>/* ===== SmartStitch – thème "Atelier Vintage Couture" (design photo 1) ===== */
      * { font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial; font-size: 13px; color: #1c2b3a; }
      QWidget#PEvenement, QWidget#contenuEvenement, QScrollArea#scrollEvenement, QFrame#contentFrameEvt { background: #f5f3ef; }
      QScrollArea#scrollEvenement { border: none; }
      /* ---------- Sidebar ---------- */
      QFrame#sidebarEvt { background: #17375e; }
      QFrame#sidebarEvt QLabel { color: #ffffff; }
      QLabel#lblUserNameEvt { font-weight: 600; font-size: 13px; }
      QLabel#lblUserRoleEvt { color: #b7c6d9; font-size: 12px; }
      QFrame#sidebarEvt QPushButton {
          color: #e8eef6; background: transparent; border: none; text-align: left;
          padding: 12px 16px; border-radius: 8px; font-size: 14px;
      }
      QFrame#sidebarEvt QPushButton:hover { background: rgba(255, 255, 255, 0.10); }
      QFrame#sidebarEvt QPushButton:checked { background: #2c527f; color: #ffffff; font-weight: 600; }
      /* ---------- En-tête ---------- */
      QLabel#lblHeaderIconEvt, QLabel#lblCalHeaderIconEvt { font-size: 34px; color: #17375e; }
      QLabel#lblTitleEvt, QLabel#lblCalPageTitleEvt { font-size: 24px; font-weight: 700; color: #17375e; }
      QLabel#lblSubtitleEvt, QLabel#lblCalPageSubtitleEvt { color: #6b7785; }
      /* ---------- Champs ---------- */
      QLineEdit, QComboBox, QDateEdit, QTimeEdit, QSpinBox#spinCapaciteEvt, QPlainTextEdit {
          background: #ffffff; border: 1px solid #d9d5ce; border-radius: 8px;
          padding: 6px 10px; min-height: 22px;
          selection-background-color: #2c527f; selection-color: #ffffff;
      }
      QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QSpinBox#spinCapaciteEvt:focus, QPlainTextEdit:focus { border: 1px solid #17375e; }
      QComboBox QAbstractItemView {
          background: #ffffff; border: 1px solid #d9d5ce;
          selection-background-color: #dce9f7; selection-color: #17375e; outline: 0;
      }
      QLineEdit#lineSearchEvt { min-height: 26px; }
      /* ---------- Boutons ---------- */
      QPushButton { background: #ffffff; border: 1px solid #17375e; color: #17375e; border-radius: 8px; padding: 8px 16px; font-weight: 600; }
      QPushButton:hover { background: #eef3f9; }
      QPushButton:pressed { background: #dce9f7; }
      QPushButton#btnAjouterEvt, QPushButton#btnEnregistrerEvt { background: #9b2335; border: 1px solid #9b2335; color: #ffffff; }
      QPushButton#btnAjouterEvt:hover, QPushButton#btnEnregistrerEvt:hover { background: #831c2c; }
      QPushButton#btnSupprimerEvt { border: 1px solid #c0392b; color: #c0392b; }
      QPushButton#btnSupprimerEvt:hover { background: #fdecea; }
      QPushButton#btnReinitialiserEvt { border: 1px solid #d9d5ce; color: #4a5a6b; font-weight: 500; }
      QPushButton#btnChoisirImageEvt { text-align: left; font-weight: 500; color: #4a5a6b; border: 1px solid #d9d5ce; }
      /* ---------- Cartes / panneaux ---------- */
      QFrame[cssClass="card"] { background: #ffffff; border: 1px solid #e3e0da; border-radius: 12px; }
      QFrame#cardTotalEvt   { border-left: 4px solid #17375e; }
      QFrame#cardAVenirEvt  { border-left: 4px solid #2f80d1; }
      QFrame#cardProgrammeEvt { border-left: 4px solid #2e9e5b; }
      QFrame#cardPlanifieEvt  { border-left: 4px solid #e0a81e; }
      QLabel[cssClass="cardIcon"] { font-size: 26px; }
      QLabel[cssClass="cardTitle"] { color: #6b7785; font-size: 12px; }
      QLabel[cssClass="cardValue"] { font-size: 26px; font-weight: 700; color: #17375e; }
      QLabel[cssClass="panelTitle"] { font-weight: 700; font-size: 14px; color: #17375e; }
      QLabel[cssClass="field"] { font-size: 12px; font-weight: 600; color: #4a5a6b; }
      QLabel[cssClass="imagePreview"] { background: #f5f3ef; border: 1px dashed #c9c4bb; border-radius: 8px; font-size: 22px; }
      /* ---------- Tableau ---------- */
      QTableWidget {
          background: #ffffff; border: 1px solid #e3e0da; border-radius: 12px;
          gridline-color: transparent; outline: 0;
          selection-background-color: #dce9f7; selection-color: #1c2b3a;
      }
      QTableWidget::item { padding: 4px 8px; border-bottom: 1px solid #f0ede8; }
      QTableWidget::item:selected { background: #dce9f7; color: #1c2b3a; }
      QHeaderView::section { background: #17375e; color: #ffffff; padding: 10px 8px; border: none; font-weight: 600; text-align: left; }
      /* ---------- Badges de statut ---------- */
      QLabel[badge] { border-radius: 10px; padding: 3px 12px; font-weight: 600; font-size: 12px; }
      QLabel[badge="programme"] { background: #d4f0dc; color: #1e7e3e; }
      QLabel[badge="planifie"]  { background: #fdf0c4; color: #a07a00; }
      QLabel[badge="annule"]    { background: #fbdcdc; color: #b42318; }
      QLabel[badge="termine"]   { background: #e1e4e8; color: #4b5563; }
      /* ---------- Liste des lieux ---------- */
      QListWidget { background: transparent; border: none; outline: 0; }
      QListWidget::item { padding: 7px 4px; border-bottom: 1px solid #f0ede8; }
      QListWidget::item:selected { background: #dce9f7; color: #17375e; }
      /* ---------- Calendrier ---------- */
      QCalendarWidget QWidget#qt_calendar_navigationbar { background: #17375e; border-radius: 6px; }
      QCalendarWidget QToolButton { color: #ffffff; background: transparent; border: none; font-weight: 600; padding: 4px 8px; }
      QCalendarWidget QToolButton:hover { background: rgba(255, 255, 255, 0.15); border-radius: 4px; }
      QCalendarWidget QSpinBox { color: #ffffff; background: transparent; border: none; }
      QCalendarWidget QAbstractItemView:enabled {
          background: #ffffff; color: #1c2b3a; outline: 0;
          selection-background-color: #17375e; selection-color: #ffffff;
      }
      QCalendarWidget QAbstractItemView:disabled { color: #b5bcc5; }
      /* ---------- Scrollbars ---------- */
      QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
      QScrollBar::handle:vertical { background: #c9c4bb; border-radius: 4px; min-height: 30px; }
      QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
      QScrollBar:horizontal { background: transparent; height: 8px; }
      QScrollBar::handle:horizontal { background: #c9c4bb; border-radius: 4px; min-width: 30px; }
      QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
      /* ---------- Graphiques (barres) ---------- */
      QProgressBar { background: #eef1f5; border: none; border-radius: 4px; min-width: 22px; max-width: 30px; }
      QProgressBar::chunk { background: #17375e; border-radius: 4px; }
      QProgressBar[cssClass="evolBar"] { min-width: 14px; max-width: 20px; }
      QProgressBar[cssClass="evolBar"]::chunk { background: #9b2335; }
      QLabel[cssClass="barValue"] { font-weight: 700; color: #17375e; font-size: 12px; }
      QLabel[cssClass="barName"] { color: #6b7785; font-size: 10px; }
      /* ---------- Page Calendrier ---------- */
      QFrame#frameCalendarEvt QCalendarWidget QAbstractItemView:enabled { font-size: 15px; }
      QFrame#frameCalendarEvt QCalendarWidget QToolButton { font-size: 14px; }
      </string>
